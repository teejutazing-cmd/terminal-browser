<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    This file contains targets that override behavior in Microsoft.UI.Xaml and
    related packages.

    Most projects need only WebView2 metadata. The browser host also needs the
    WinRT implementation and its activation manifest. The WinRT component
    statically includes the loader, so no separate WebView2Loader is required.
  -->
  <ItemGroup>
    <Reference Include="$(WebView2PackageRoot)\lib\Microsoft.Web.WebView2.Core.winmd">
      <Implementation Condition="'$(ProjectName)' == 'WindowsTerminal'">Microsoft.Web.WebView2.Core.dll</Implementation>
    </Reference>
    <ReferenceCopyLocalPaths Include="$(WebView2PackageRoot)\runtimes\win-$(Platform)\native_uap\Microsoft.Web.WebView2.Core.dll"
                             Condition="'$(ProjectName)' == 'WindowsTerminal'" />
  </ItemGroup>
</Project>
